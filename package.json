{
  "name": "platter",
  "version": "0.1.0",
  "description": "Two turntables, a club mixer and a crate in the browser — scratch, sync, key lock, loops and hot cues on your own music.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "worklets": "node scripts/extract-stretch-worklet.mjs",
    "predev": "npm run worklets",
    "dev": "vite",
    "prebuild": "npm run worklets",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test:e2e": "node tests/e2e.mjs",
    "artifact": "npm run build && node scripts/artifact.mjs"
  },
  "dependencies": {
    "music-metadata": "12.3.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "signalsmith-stretch": "1.3.2",
    "web-audio-beat-detector": "8.2.39"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "1.63.0",
    "typescript": "^5",
    "vite": "^6.4.2"
  }
}
