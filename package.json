{
  "name": "platter",
  "version": "0.1.0",
  "description": "Two turntables, a club mixer and a crate in the browser — scratch, sync, key lock, loops and hot cues on your own music.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "worklets": "node scripts/extract-stretch-worklet.mjs",
    "predev": "npm run worklets",
    "dev": "vite",
    "prebuild": "npm run worklets",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test:e2e": "node tests/e2e.mjs",
    "test:controls": "node tests/controls.mjs",
    "test:listening": "node tests/listening.mjs",
    "test:sync": "node tests/sync.mjs",
    "artifact": "npm run build && node scripts/artifact.mjs",
    "test:stems": "node tests/stems.mjs && node tests/spectral.mjs",
    "test:returning-visitor": "node tests/returning-visitor.mjs",
    "test:library-dsp": "node tests/library-dsp.mjs",
    "test:sound": "node tests/sound.mjs",
    "library": "node scripts/library.mjs",
    "test:library": "node tests/library.mjs",
    "eval:accuracy": "node scripts/eval-accuracy.mjs",
    "test:stems-reload": "node tests/stems-reload.mjs",
    "test:presplit": "node tests/stemfile.mjs && node tests/presplit.mjs",
    "test:slicer-dsp": "node tests/slicer-dsp.mjs",
    "test:beat-pitch": "node tests/beat-pitch.mjs",
    "test:stem-pitch": "node tests/stem-pitch.mjs",
    "test:slicer": "node tests/slicer.mjs",
    "test:perf": "node tests/perf.mjs",
    "perf:trace": "node tests/perf-trace.mjs"
  },
  "dependencies": {
    "demucs-web": "1.0.2",
    "music-metadata": "12.3.2",
    "onnxruntime-web": "1.31.1",
    "pitchy": "4.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "signalsmith-stretch": "1.3.2",
    "wavesurfer.js": "8.1.0",
    "web-audio-beat-detector": "8.2.39"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "1.63.0",
    "typescript": "^5",
    "vite": "^6.4.2"
  }
}
